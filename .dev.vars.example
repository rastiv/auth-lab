# Copy to .dev.vars. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Not used locally: in dev, emails are printed to the terminal instead of sent.
RESEND_API_KEY=
# Cloudflare's test secret: every token passes. Production uses the real one.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# From a separate GitHub OAuth App whose callback is
# http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# From a separate Google OAuth client whose redirect URI is
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
