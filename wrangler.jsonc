/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-10",
	"assets": {
		"not_found_handling": "single-page-application",
		// Without this, browser navigations to /api/* (OAuth callbacks, magic links,
		// email verification) would get the SPA's index.html instead of the Worker.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth-lab",
			"migrations_dir": "worker/db/migrations"
		}
	],
	// Public config only; secrets go in .dev.vars locally and `wrangler secret put` in production.
	// .dev.vars overrides these during local development.
	"vars": {
		"BETTER_AUTH_URL": "https://auth.rastiv.dev"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
