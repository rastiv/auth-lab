/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-10",
	// Serve only on the custom domain: auth (BETTER_AUTH_URL, cookies, OAuth
	// callbacks) is tied to a single origin.
	"routes": [{ "pattern": "auth.rastiv.dev", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"not_found_handling": "single-page-application",
		// Without this, browser navigations to /api/* (OAuth callbacks, magic links,
		// email verification) would get the SPA's index.html instead of the Worker.
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auth-lab",
			"database_id": "ec38cd29-9300-4328-ae27-2ba2f1eb1bab",
			"migrations_dir": "worker/db/migrations"
		}
	],
	// Daily at 03:00 UTC: delete auth events past the retention period.
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	// Declared here so `wrangler types` works without .dev.vars (e.g. in CI).
	// Values: .dev.vars locally, `wrangler secret put` in production.
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY", "TURNSTILE_SECRET_KEY", "GITHUB_CLIENT_SECRET", "GOOGLE_CLIENT_SECRET"]
	},
	// Public config only; secrets never go here.
	// .dev.vars overrides these during local development.
	"vars": {
		"BETTER_AUTH_URL": "https://auth.rastiv.dev",
		"EMAIL_FROM": "auth-lab <no-reply@mail.rastiv.dev>",
		// OAuth client IDs are public (they are in the redirect URL); .dev.vars
		// overrides them with the localhost apps. Client secrets are Worker secrets.
		"GITHUB_CLIENT_ID": "Ov23lispQtg1dK82IbVA",
		"GOOGLE_CLIENT_ID": "376081981511-eebco77lv8o45mt9oml9c8k6qcj8m1ht.apps.googleusercontent.com"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
