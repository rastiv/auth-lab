{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // The Worker is bundled by Vite, so resolve imports like the app does.
    "module": "esnext",
    "moduleResolution": "bundler",
    // Workers runtime types (generated by `wrangler types`), not Node's;
    // vite/client for import.meta.env, since Vite builds the Worker too.
    "types": ["./worker-configuration.d.ts", "vite/client"]
  },
  "include": ["worker", "shared"]
}
